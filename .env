# ARR Stack Configuration (template)
# Copy this file to .env.local and customize values for your deployment

# User & Group IDs (match your host system)
PUID=1000
PGID=1000

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Africa/Johannesburg

# Host Paths (update these to match your system)
MEDIA_PATH=/data/media
DOWNLOADS_PATH=/data/downloads
APPDATA_PATH=/data/appdata

# Service Ports
PLEX_PORT=32400
QBITTORRENT_PORT=8081
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
OVERSEERR_PORT=5055
JACKETT_PORT=9117
FLARESOLVERR_PORT=8191
LAZYLIBRARIAN_PORT=8299

# Container Restart Policy (no, always, unless-stopped, on-failure)
RESTART_POLICY=unless-stopped

# Optional: Plex version (docker, latest, or specific version)
PLEX_VERSION=docker
