# Copy to .env and adjust:  cp .env.example .env
# In Portainer: Stack -> Environment variables -> "Load variables from .env file".
# Never commit .env — it holds API keys.

# User/group the containers run as (run `id` on the host)
PUID=1000
PGID=1000
TZ=Africa/Johannesburg

# Host paths. DATA_PATH holds media/ and downloads/ on one filesystem, so
# Sonarr/Radarr can hardlink imports (no extra disk space) instead of copying.
APPDATA_PATH=/home/supervisor/appdata
DATA_PATH=/home/supervisor/share
# These two must be the media/ and downloads/ folders inside DATA_PATH.
MEDIA_PATH=/home/supervisor/share/media
DOWNLOADS_PATH=/home/supervisor/share/downloads

# Web UI ports
QBITTORRENT_PORT=8080
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
SEERR_PORT=5055
JACKETT_PORT=9117
FLARESOLVERR_PORT=8191
TAUTULLI_PORT=8181
MAINTAINERR_PORT=6246
TDARR_PORT=8265
UPTIME_KUMA_PORT=3001

# CPU caps (number of cores). Host has 4 vCPUs and no GPU, so Plex transcodes
# in software; these stop one busy container from starving the rest.
PLEX_CPUS=3
UNPACKERR_CPUS=1
FLARESOLVERR_CPUS=1
TDARR_CPUS=2

# Memory cap for FlareSolverr (leaks Chromium processes over time).
FLARESOLVERR_MEM=1g

# Unpackerr -> Sonarr/Radarr. Copy from each app: Settings -> General -> API Key.
# On a restore from appdata backup these keys are unchanged.
SONARR_API_KEY=
RADARR_API_KEY=

# Optional services: "tdarr" (library re-encoding), "monitoring" (Uptime Kuma alerts),
# "bot" (Telegram bot). Example: COMPOSE_PROFILES=monitoring,bot
COMPOSE_PROFILES=

# VPN add-on (docker-compose.vpn.yml): Proton VPN WireGuard private key and
# server countries. Proton → Downloads → WireGuard configuration, with
# "NAT-PMP (Port Forwarding)" ON. Keep the key secret.
WIREGUARD_PRIVATE_KEY=
VPN_COUNTRIES=Netherlands

# Telegram bot (bot profile): token from @BotFather. TELEGRAM_CHAT_ID = chats it
# answers, comma-separated: your private chat ID and optionally a group ID (negative
# number). Everyone in those chats gets read-only commands; /restart and /clearstuck
# only for TELEGRAM_ADMIN_IDS (default: the private chat ID = your user ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
# Commands for everyone else (default: status,disk,vpn,downloads,stuck,recent,leaving,search)
TELEGRAM_DEFAULT_COMMANDS=
# Per-person overrides: user_id=cmd,cmd;user_id=cmd  (IDs appear in `docker logs arrbot`)
TELEGRAM_USER_COMMANDS=
